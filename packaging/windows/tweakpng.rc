			VALUE "ProductVersion", "1.4.6+\0"
			VALUE "LegalCopyright", "Copyright (C) 1999-2023 Jason Summers\0"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
